#: kontoros-company-lookup.php:67
msgid "Settings"
msgstr "Nustatymai"

#. Author of the plugin
#: kontoros-company-lookup.php
#: includes/class-settings.php:38
msgid "Kontoros"
msgstr "Kontoros"

#: includes/class-settings.php:45
msgid "Company lookup"
msgstr "Įmonių paieška"

#. translators: %s: link to kontoros.lt API documentation
#: includes/class-settings.php:48
#, php-format
msgid "Customers start typing a company name or code in the Company field on checkout and pick it from the list; the company code, VAT code and address are filled in automatically. Data comes from the free %s."
msgstr "Pirkėjas užsakymo formos lauke „Įmonė“ pradeda rašyti įmonės pavadinimą arba kodą ir pasirenka ją iš sąrašo; įmonės kodas, PVM kodas ir adresas užpildomi automatiškai. Duomenys gaunami iš nemokamo %s."

#: includes/class-settings.php:52
msgid "Enable"
msgstr "Įjungti"

#: includes/class-settings.php:54
msgid "Enable company autocomplete on checkout"
msgstr "Įjungti įmonių paiešką užsakymo formoje"

#: includes/class-settings.php:59
msgid "Company code and VAT fields"
msgstr "Įmonės kodo ir PVM kodo laukai"

#: includes/class-settings.php:61
msgid "Add \"Company code\" and \"VAT code\" fields to the billing address"
msgstr "Pridėti laukus „Įmonės kodas“ ir „PVM kodas“ prie mokėtojo adreso"

#: includes/class-settings.php:62
msgid "Turn off if another plugin already adds these fields. They are saved to the order and shown in the admin and in emails."
msgstr "Išjunkite, jei šiuos laukus jau prideda kitas įskiepis. Reikšmės išsaugomos užsakyme ir rodomos administravime bei el. laiškuose."

#: includes/class-settings.php:75
msgid "Company name"
msgstr "Įmonės pavadinimas"

#: includes/class-settings.php:80
msgid "Short form (UAB \"Jungtis\")"
msgstr "Trumpas (UAB „Jungtis“)"

#: includes/class-settings.php:81
msgid "Official register name (Uždaroji akcinė bendrovė \"Jungtis\")"
msgstr "Oficialus registro pavadinimas (Uždaroji akcinė bendrovė „Jungtis“)"

#: includes/class-settings.php:85
msgid "Address"
msgstr "Adresas"

#: includes/class-settings.php:87
msgid "Also fill street, city, county, postcode and country with the registered address"
msgstr "Užpildyti ir gatvę, miestą, apskritį, pašto kodą bei šalį registracijos adresu"

#: includes/class-settings.php:92
msgid "Active companies only"
msgstr "Tik veikiančios įmonės"

#: includes/class-settings.php:94
msgid "Hide deregistered and liquidated companies"
msgstr "Nerodyti išregistruotų ir likviduojamų įmonių"

#: includes/class-settings.php:99
msgid "Data source credit"
msgstr "Duomenų šaltinis"

#: includes/class-settings.php:101
msgid "Show a small \"Data: kontoros.lt\" line under the suggestions"
msgstr "Rodyti nedidelę eilutę „Duomenys: kontoros.lt“ po pasiūlymais"

#: includes/class-settings.php:106
msgid "API key (optional)"
msgstr "API raktas (nebūtinas)"

#: includes/class-settings.php:110
msgid "Not required. Without a key the shop may make 100 lookups per 5 minutes and 1000 per day; results are cached for 10 minutes. Contact kontoros.lt for a key with higher limits."
msgstr "Nebūtinas. Be rakto parduotuvė gali atlikti 100 paieškų per 5 minutes ir 1000 per parą; rezultatai talpinami 10 minučių. Raktą su didesniais limitais galite gauti susisiekę su kontoros.lt."

#: includes/class-checkout.php:41
#: includes/class-checkout.php:65
#: includes/class-checkout.php:154
#: includes/class-checkout.php:169
#: includes/class-checkout.php:184
msgid "Company code"
msgstr "Įmonės kodas"

#: includes/class-checkout.php:48
#: includes/class-checkout.php:76
#: includes/class-checkout.php:157
#: includes/class-checkout.php:172
#: includes/class-checkout.php:187
msgid "VAT code"
msgstr "PVM kodas"

#: includes/class-checkout.php:66
msgid "Company code (optional)"
msgstr "Įmonės kodas (nebūtinas)"

#: includes/class-checkout.php:77
msgid "VAT code (optional)"
msgstr "PVM kodas (nebūtinas)"

#: includes/class-checkout.php:103
msgid "Code"
msgstr "Kodas"

#: includes/class-checkout.php:104
msgid "VAT"
msgstr "PVM"

#: includes/class-checkout.php:105
msgid "not active"
msgstr "neveikia"

#: includes/class-checkout.php:106
msgid "Data: kontoros.lt"
msgstr "Duomenys: kontoros.lt"

#: includes/class-settings.php:67
msgid "Company field"
msgstr "Įmonės laukas"

#: includes/class-settings.php:69
msgid "Show the Company field on checkout if it is hidden"
msgstr "Rodyti lauką „Įmonė“ užsakymo formoje, jei jis paslėptas"

#: includes/class-settings.php:70
msgid "WooCommerce hides the Company field by default and then discards the company name. When on, a hidden Company field is shown as optional. A field you set to Required stays required."
msgstr "WooCommerce pagal nutylėjimą slepia lauką „Įmonė“ ir tada įmonės pavadinimas neišsaugomas. Įjungus, paslėptas laukas rodomas kaip nebūtinas. Jei laukas nustatytas kaip privalomas, jis toks ir lieka."

#. Plugin Name of the plugin
#: kontoros-company-lookup.php
msgid "Kontoros Company Lookup for WooCommerce"
msgstr "Kontoros Company Lookup for WooCommerce"

#. Plugin URI of the plugin
#: kontoros-company-lookup.php
msgid "https://www.kontoros.lt/api"
msgstr ""

#. Description of the plugin
#: kontoros-company-lookup.php
msgid "Lithuanian company autocomplete for the WooCommerce checkout: company name, company code, VAT code and registered address, from the free kontoros.lt API."
msgstr "Lietuvos įmonių paieška WooCommerce užsakymo formoje: įmonės pavadinimas, kodas, PVM kodas ir registracijos adresas iš nemokamo kontoros.lt API."

#. Author URI of the plugin
#: kontoros-company-lookup.php
msgid "https://www.kontoros.lt"
msgstr ""
